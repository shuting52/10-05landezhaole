<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主题（反编译精简：仅保留应用自身需要的样式，库样式由依赖提供） -->
    <style name="Theme.MyApplication" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    </style>
    <style name="DialogWindowTheme" parent="">
        <item name="android:windowClipToOutline">false</item>
    </style>
    <style name="EdgeToEdgeFloatingDialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowClipToOutline">false</item>
    </style>
</resources>
